# 服务器配置
PORT=53300
NODE_ENV=development

# 数据库配置
# 可选值: sqlite 或 postgresql
DB_TYPE=sqlite

# SQLite 配置
SQLITE_PATH=./data/carnote.db
# 数据库备份目录 (如果未指定，SQLite 会默认备份在数据库文件所在目录)
BACKUP_PATH=./data/backups

# PostgreSQL 配置 (当 DB_TYPE=postgresql 时使用)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=carnote
PG_USER=postgres
PG_PASSWORD=password

# 上传文件存储路径
UPLOAD_PATH=./uploads

# Captcha 签名密钥 (认证会话使用数据库令牌，不依赖此密钥)
JWT_SECRET=your-secret-key-change-this-in-production

# CORS 允许的前端来源，多个用逗号分隔；留空表示仅允许同源
# 开发环境通过 Vite 代理访问后端时无需配置
CORS_ORIGIN=

# 登录会话有效期（天，默认 7，最大 30）
SESSION_TTL_DAYS=7

# 仅在 HTTPS 下发送会话 Cookie；留空则根据请求协议自动判断
COOKIE_SECURE=

# 可信反向代理配置。默认信任本机/内网代理（适用于 Nginx、Docker）。
# 也支持代理层数（如 1）或 IP/CIDR 列表；后端直接暴露公网且无代理时设为 false。
TRUST_PROXY=loopback, linklocal, uniquelocal
